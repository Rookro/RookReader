{
    "name": "tauri-devcontainer",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.vscode-typescript-next",
                "rust-lang.rust-analyzer",
                "tauri-apps.tauri-vscode",
                "EditorConfig.EditorConfig"
            ]
        }
    },
    "mounts": [
        "source=${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY},target=/tmp/wayland-0,type=bind"
    ],
    "containerEnv": {
        "WAYLAND_DISPLAY": "wayland-0",
        "XDG_RUNTIME_DIR": "/tmp",
        "DISPLAY": "${localEnv:DISPLAY}"
    },
    "remoteUser": "vscode"
}
