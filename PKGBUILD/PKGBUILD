# Maintainer: Rookro
pkgname=RookReader
pkgver=2.4.0
pkgrel=1
pkgdesc="The book reader for a archive or pdf file."
arch=('x86_64')
url="https://github.com/Rookro/RookReader"
license=('MIT')
depends=('webkit2gtk-4.1' 'hicolor-icon-theme')
options=('!strip' '!debug')
source_x86_64=("${url}/releases/download/v${pkgver}/${pkgname}_${pkgver}_amd64.deb")
sha256sums_x86_64=('SKIP')
package() {
  tar -xvf data.tar.gz -C "${pkgdir}"
}
